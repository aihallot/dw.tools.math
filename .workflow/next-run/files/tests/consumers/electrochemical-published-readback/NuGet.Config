<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="published-math" value="I:\nuget.local" />
  </packageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <packageSourceMapping>
    <clear />
    <packageSource key="published-math">
      <package pattern="dw.quantities" />
      <package pattern="dw.quantities.expression" />
      <package pattern="dw.quantities.standard" />
    </packageSource>
  </packageSourceMapping>
</configuration>
