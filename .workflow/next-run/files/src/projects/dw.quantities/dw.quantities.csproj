<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>dw.quantities</AssemblyName>
    <RootNamespace>Dw.Quantities</RootNamespace>
    <PackageId>dw.quantities</PackageId>
    <Version>0.2.0-preview.1</Version>
    <Authors>dw.tools.math</Authors>
    <Description>Standalone exact quantities package extracted from the authorized AURA mathematical core.</Description>
    <IsPackable>true</IsPackable>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
