  "title": "Qualify standalone exact numerical and symbolic public console vertical",
  "commitMessage": "feat: qualify exact numerical-symbolic console vertical and open M5 W02",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M5",
    "M5-W02",
    "M5-W02-C01",
    "M5-W02-C01-T1",
