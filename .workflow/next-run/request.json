  "id": "RS057",
  "title": "Qualify bounded exact symbolic transformations with domain-safe substitution and real square root",
  "commitMessage": "feat: qualify bounded exact symbolic transformations and closed substitutions",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M4",
    "M4-W01",
    "M4-W01-C03",
    "M4-W01-C03-T1",
