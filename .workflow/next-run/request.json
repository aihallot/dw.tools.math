  ],
  "contribution": {
    "summary": "Qualify bounded BCL-only direct complex DFT (negative forward sign, positive inverse with 1/N) and real zero-extended linear convolution. Recover one compiled missing-public-API RED, pass 59 independent GREEN tests and 404 retained scientific tests, four Math regressions, and three SHA-matched eight-probe NuGet-only preview.7 clients. Close only S02-T1 R/G/V and T1; retain S02-T2, S02, S03, original C03, M6-W02 and M6 unfinished.",
    "value": "Provide finite 1..32-sample managed O(N^2) DFT and real noncircular convolution contracts with explicit input/output budgets, typed nonpartial refusals and cancellation. Preserve approximate binary64 semantics, independent oracles, no invented FFT, physical units, certified error bounds or downstream agent adoption.",
    "debtChanges": [
      "Observe one genuinely compiled independent missing-public direct-signal API RED before staging the new facade; compiler failure does not count as RED.",
      "Recover the RED and pass 59 separate numerical GREEN tests for complex DFT sign/inverse, real convolution, dimensions, finite budget and cancellation.",
      "Specify forward negative-exponent direct O(N^2) DFT, inverse positive exponent with 1/N normalization, no FFT or alias-free signal theorem.",
      "Qualify real zero-extended linear convolution of two length-1..32 arrays with output length N+M-1, not periodic/circular convolution.",
      "Bound binary64 input components to 1e6 absolute and results to 4e13 absolute; type InvalidLength, InvalidInput, OutsideQualifiedRange and Cancelled refusals.",
      "Preserve 53 S01-T2, 25 S01-T1, 88 C02-T2, 80 C02-T1, 88 C01-T2 and 70 C01-T1 scientific tests plus four Math regressions.",
      "Pack and inspect a real local scientific preview.7 archive with net10 DLL, nuspec identity, no foreign NuGet dependencies and exact SHA-256.",
      "Verify three independently cached source-free eight-probe NuGet consumers, each pinned to preview.7 and agreeing on actual archive byte count and SHA.",
      "Close S02-T1-R/G/V and T1 only in both accepted backlog and DWF plan; keep S02-T2, S02 phase, S03, parent C03 and M6 gates uncompleted."
    ],
    "nextAction": "After durable RS095 success, prepare RS096 on M6-W02-C03-S02-T2: direct DFT sign/inverse, aliasing, finite intermediate, cancellation and linear-versus-circular boundary audits with independent RED/GREEN and NuGet evidence. Keep S03, original C03 and M6 open.",
    "achievements": [
      {
        "projectNode": "M6-W02-C03-S02-T1-R",
        "achievement": "Observe one compiled independent missing-public finite direct DFT and linear convolution API RED before staging the numerical facade."
      },
      {
        "projectNode": "M6-W02-C03-S02-T1-G",
        "achievement": "Recover the RED and pass 59 independent direct complex DFT, inverse, real zero-extended convolution and typed refusal GREEN tests."
      },
      {
        "projectNode": "M6-W02-C03-S02-T1-V",
        "achievement": "Verify 404 retained scientific tests and four Math regressions, and SHA-inspect one actual preview.7 NuGet archive through three isolated eight-probe clients."
      },
      {
        "projectNode": "M6-W02-C03-S02-T1",
        "achievement": "Qualify finite O(N^2) complex DFT with explicit sign/inverse and bounded real linear convolution; preserve S02-T2, S02 and parent gates."
      }
    ]
  },
