  "schemaVersion": 1,
  "id": "RS089",
  "title": "Qualify signed exact arithmetic and intermediate-size boundary policies",
  "commitMessage": "feat: qualify exact integer sign and intermediate budgets and close M6 W02 C01",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M6",
    "M6-W02",
    "M6-W02-C01",
    "M6-W02-C01-T2",
    "M6-W02-C01-T2-R",
    "M6-W02-C01-T2-G",
    "M6-W02-C01-T2-V"
  ],
  "contribution": {
    "summary": "Qualify explicit signed magnitude policies and finite intermediate-size limits in exact scientific Math preview.2, preserving prior T1 behavior. Recover one compiled public API RED; pass 87 new GREEN, 70 retained T1 tests and four core regressions. SHA-inspect a real local net10 NuGet archive in two independent eight-probe source-free consumers. Close C01-T2 and C01 only; leave M6-W02/M6, primality guarantees, public release and downstream adoption open.",
    "value": "Keep exact BigInteger GCD/LCM negative-input refusal by default, allow deliberate magnitude normalization, and refuse oversized arithmetic-series intermediates even when exact cancellation masks them in the final result.",
    "nextAction": "After durable RS089 success, prepare M6-W02-C02-T1 for bounded and provider-neutral special functions, real/complex domain decisions and independent Gamma/trigonometric oracles. Keep M6-W02 and M6 open.",
    "debtChanges": [
      "Observe one genuinely compiled missing public exact-boundary-audit API RED before staging the new sidecar source.",
      "Keep T1 negative Euclidean inputs refused by default; require explicit caller-selected magnitude normalization, recording only actual normalization.",
      "Bound signed arithmetic-series intermediate products independently from final result, operand bits and logical step budgets to prevent cancellation from hiding growth.",
      "Preserve finite factorial/binomial domains, exact BigInteger arithmetic, typed no-partial refusals and cancellation; do not invent primality/probability claims.",
      "Recover the compiled RED and require 87 independent GREEN plus all 70 qualified T1 tests, full scientific test project and four Math regressions.",
      "Inspect real BCL-only net10 preview.2 archive bytes and compare SHA-256 in two separately restored eight-probe source-free NuGet clients.",
      "Complete C01-T2 R/G/V and phase C01 only; M6-W02 and M6, unobserved platforms, stable NuGet and AURA/Decision/MCDM adoption remain open."
    ],
    "achievements": [
      {
        "projectNode": "M6-W02-C01-T2-R",
        "achievement": "Observe a genuinely compiled reflection RED for the missing exact-scientific signed-input and intermediate-budget audit public surface."
      },
      {
        "projectNode": "M6-W02-C01-T2-G",
        "achievement": "Add caller-opt-in magnitude normalization, bounded arithmetic-series intermediates and 87 independently asserted exact GREEN test oracles."
      },
      {
        "projectNode": "M6-W02-C01-T2-V",
        "achievement": "Preserve 70 qualified T1 tests and four Math regressions, inspecting one real scientific preview.2 archive in two distinct eight-probe NuGet-only consumers."
      },
      {
        "projectNode": "M6-W02-C01-T2",
        "achievement": "Qualify explicit signed-domain and resource-size boundaries while retaining T1 contracts and truthful nonclaims about primality and unbounded work."
      },
      {
        "projectNode": "M6-W02-C01",
        "achievement": "Complete exact integer/combinatorial T1 and boundary T2 with compiled RED/GREEN scientific evidence and local SHA-qualified NuGet interoperability."
      }
    ]
  },
