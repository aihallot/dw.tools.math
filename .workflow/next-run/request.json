  "contribution": {
    "summary": "Qualify the existing exact annotated MathML 3 profile against hostile XML, DTD/entities, namespace spoofing, altered content/presentation, noncanonical serialization and node/depth budgets. Independently replay typed IR and bind bounded source SHA-256 without treating it as mathematical proof. Require a compiled RED, 42 GREEN tests, eight isolated NuGet probes and three inspected packages. Close C03 only; keep W01 and M5 open.",
    "value": "Provide independent .NET mathematical consumers with exact source-bound MathML structural fidelity and explicit XML/presentation refusals without expanding the admitted interchange grammar.",
    "debtChanges": [
      "Observe a compiled missing public MathML boundary-audit API RED against qualified codecs preview.5 before installing preview.6.",
      "Reuse the already admitted MathML 3 reader without a second XML parser, DTD, external entity resolver, arbitrary presentation inference or general XML sanitizer.",
      "Bind a SHA-256 of bounded original UTF-8 XML bytes separately from Math IR semantic structural hash; refuse oversized input before allocating a source digest.",
      "Replay canonical Math IR JSON, exact canonical text, and Content/Presentation branches against the source document before admitting a structural fidelity rule.",
      "Falsify unannotated display, wrong namespaces and encodings, altered Content/Presentation/source annotations, DTD/entities, malformed XML and resource exhaustion with typed losses.",
      "Pass 42 new independent GREEN MSTests and the compiled RED; run focused full codecs, exact IR and quantities regressions under locked .NET 10 Release build.",
      "Inspect three local net10 packages, nuspec/dependency graphs, real archive SHA-256 and run eight standalone pinned NuGet-only consumer probes without foreign CAS/agent runtime.",
      "Close only C03-T2 RED/GREEN/verification, T2 and C03 with durable evidence. Keep W01/M5 in-progress and C04 Markdown/Office work not-ready."
    ],
    "nextAction": "After durable RS071 success, qualify M5-W01-C04-T1 Markdown/Office mathematical interchange with original typed IR and explicit presentation-loss boundaries.",
    "achievements": [
      {
        "projectNode": "M5-W01-C03-T2-R",
        "achievement": "Observe one genuinely compiled missing exact MathML XML boundary and provenance API RED against qualified codecs preview.5."
      },
      {
        "projectNode": "M5-W01-C03-T2-G",
        "achievement": "Admit bounded source-bound MathML structural fidelity and precise typed refusal semantics with 42 independent GREEN tests and eight package-only probes."
      },
      {
        "projectNode": "M5-W01-C03-T2-V",
        "achievement": "Qualify local codecs preview.6 archive hashes, entity/DTD/depth refusals, exact canonical IR transport, runtime evidence and independent consumers."
      },
      {
        "projectNode": "M5-W01-C03-T2",
        "achievement": "Complete the bounded MathML XML security, source provenance and ambiguity boundary over the existing annotated exact profile."
      },
      {
        "projectNode": "M5-W01-C03",
        "achievement": "Complete accepted Content and Presentation MathML exact annotated interchange and its independently verified XML/loss boundary without closing W01 or M5."
      }
    ]
  },
