  "contribution": {
    "summary": "Deliver the first independent .NET 10 numerical/symbolic console vertical over exact x²-1 with x!=1. Compose existing canonical parsing, IR replay, formal derivative 2x, point evaluation at x=2 -> 3, original-domain audited root -1 and excluded point 1, typed exact/binary64 outcomes and incompatible-pipeline refusal. Require one compiled RED, 34 independent GREEN tests, eight pinned NuGet console probes and seven archive inspections. Open M5-W02/C01; finish T1 only.",
    "value": "Expose a real package-only console consumer that integrates qualified Math engines without AURA or a CAS, preserves exact source IR and original-domain exclusions, and separates formal differentiation, verified roots, numerical precision and evidence-backed replay.",
    "nextAction": "After durable RS074 success, independently qualify M5-W02-C01-T2 original-domain, derivative-vs-solving, provider, loss, rounding and incompatible-pipeline boundaries; keep packaging and 1.0 promotion gates separate.",
    "debtChanges": [
      "Compile and observe a genuine public exact numerical/symbolic runner absent-API RED with the new distribution contract present before staging the runner.",
      "Reuse qualified Math IR, canonical notation, symbolic differentiation, finite-point polynomial evaluation and exact elementary root solving; do not write a second CAS.",
      "Use original restricted IR root auditing to retain admissible root -1, exclude x=1 and avoid claiming a complete original-root proof from an unrestricted candidate set.",
      "Produce 2x as the formal derivative of the body only; reject substituting this derivative for the original equation in the root-composition stage.",
      "Keep exact rational and explicit IEEE binary64 composition separate, retain exact absolute rounding error and require explicit AllowRounded policy.",
      "Register new lowercase distribution and test projects and exact solution paths, with centralized MSTest versions, manually reviewed lock graphs and build/artifacts output.",
      "Recover the compiled RED, pass 34 independent GREEN tests and six related locked-build component regression packs, then validate native DWF and planning projections.",
      "Inspect seven rebuilt local net10 product archives, nuspec dependency graphs, actual sizes and SHA-256; run eight sample probes from one pinned NuGet-only distribution reference."
    ],
    "achievements": [
      {
        "projectNode": "M5-W02-C01-T1-R",
        "achievement": "Observe a genuinely compiled missing public exact numerical/symbolic distribution runner RED with a present independent contract library."
      },
      {
        "projectNode": "M5-W02-C01-T1-G",
        "achievement": "Deliver the exact source-bound x²-1 restricted vertical, derivative 2x, value 3 at x=2, root -1 and excluded 1 with 34 independent GREEN oracles."
      },
      {
        "projectNode": "M5-W02-C01-T1-V",
        "achievement": "Qualify source IR replay, explicit binary64 and incompatible pipeline refusals, seven local NuGet archive hashes and eight standalone pinned console probes."
      },
      {
        "projectNode": "M5-W02-C01-T1",
        "achievement": "Complete the first public .NET 10 numerical/symbolic console vertical contract while preserving C01, W02, M5 and stable 1.0 gates as incomplete."
      }
    ]
  },
