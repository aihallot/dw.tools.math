        "projectNode": "M2-W01-C03-T1-G",
        "achievement": "Versioned math-ir/1 codec carries exact BigInteger fractions, binary64 bits, quantities, symbol binding, matrices and domain restrictions in deterministic JSON."
      },
      {
        "projectNode": "M2-W01-C03-T1-V",
        "achievement": "Ten round-trip oracles plus existing IR, quantities, foundation and locked-build regressions qualify structural determinism and exact typed values."
      },
      {
        "projectNode": "M2-W01-C03-T1",
        "achievement": "The functional canonical codec contract closes with observed RED and executable GREEN; adversarial decoding and semantic/presentation hashing remain in T2."
      }
    ]
