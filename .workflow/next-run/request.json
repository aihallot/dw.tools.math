  "title": "Qualify one bounded exact dimension-aware quantity pipeline for direct and fluent APIs",
  "commitMessage": "feat: add exact typed quantity composition pipeline",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M2",
