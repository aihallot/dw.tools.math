  "contribution": {
    "summary": "Qualify explicit ACT/365 Fixed and ACT/360 actual-day discounts and bounded dated IRR with typed sign-pattern, all-zero and root-not-bracketed refusals. Recover one compiled missing-API RED, pass 90 GREEN, retain 904 scientific tests and four Math regressions, and verify seven source-free preview.14 NuGet clients with identical SHA. Close C04-T2 R/G/V, T2 and C04 only; leave C05, M6-W02 and M6 open.",
    "value": "DateOnly coordinates, effective annual rates and fixed actual-day denominators are caller-declared. One-sign-change IRR uses a finite explicit bracket; multiple sign changes conservatively refuse possible multiple roots, without claiming a global root count or absence outside the bracket. No market data, advice, implicit calendars or certified error theorem.",
    "nextAction": "After durable RS102 success, prepare RS103 on M6-W02-C05-T1: document admitted scientific families, oracle/limit/provider pins and a targeted Decision primitive deduplication request without automatic external cutover. Leave C05-T2, M6-W02 and M6 open.",
    "debtChanges": [
      "Observe one genuinely compiled missing actual-day financial public API RED before sidecar staging; a compiler error is not independent RED evidence.",
      "Recover RED with 90 GREEN tests for ACT/365 Fixed, ACT/360, leap actual days, dated IRR, typed invalid-date and root-topology refusals.",
      "Preserve caller-declared actual DateOnly coordinates, fixed day-count denominators, effective annual rate basis and bounded 100-year date horizon.",
      "Explicitly distinguish all-zero indeterminate flows, no-sign-change flows, potential multiple roots and no sign bracket, without a global root-count theorem.",
      "Reject absent/unknown day-count, duplicate/decreasing dates, invalid rate bracket, nonfinite/out-of-budget flows and cancellation with no partial values.",
      "Retain 67 C04-T1 and 837 C01/C02/C03 scientific tests, the full scientific suite, four Math regressions and transfer validation.",
      "Pack and SHA-inspect one real local scientific preview.14 net10 NuGet archive and exact nuspec identity with no unadmitted dependencies.",
      "Restore seven separately cached pinned preview.14 eight-probe consumers only from a cleared local feed, requiring matching actual archive byte/SHA receipts.",
      "Keep pure T1 effective-per-period discount and IRR unchanged; no pricing feed, finance recommendations, implicit business-day or ACT/ACT convention.",
      "Close C04-T2 R/G/V and T2 and C04 only after durable evidence; C05, M6-W02 and milestone M6 remain unfinished."
    ],
    "achievements": [
      {
        "projectNode": "M6-W02-C04-T2-R",
        "achievement": "Observe one compiled independent RED for absent public actual-day financial discount and dated IRR API before source staging."
      },
      {
        "projectNode": "M6-W02-C04-T2-G",
        "achievement": "Recover RED and pass 90 independent fixed-day-denominator discount, dated-IRR, ambiguous-root, no-root-bracket and typed refusal tests."
      },
      {
        "projectNode": "M6-W02-C04-T2-V",
        "achievement": "Preserve 904 scientific tests and four Math regressions, and SHA-verify real preview.14 through seven isolated eight-probe source-free NuGet clients."
      },
      {
        "projectNode": "M6-W02-C04-T2",
        "achievement": "Qualify bounded explicitly dated financial arithmetic, caller-selected ACT/365 Fixed or ACT/360 and conservative root topology refusals."
      },
      {
        "projectNode": "M6-W02-C04",
        "achievement": "Close C04 after separately evidenced T1 period-rate contracts and T2 date/day-count/root-topology boundaries; retain C05 and M6 gates."
      }
    ]
