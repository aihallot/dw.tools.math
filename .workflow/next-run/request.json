  "id": "RS095",
  "title": "Qualify bounded direct complex DFT and real linear convolution",
  "commitMessage": "feat: qualify bounded direct DFT and linear convolution in Math scientific",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M6",
    "M6-W02",
    "M6-W02-C03-S02",
    "M6-W02-C03-S02-T1",
    "M6-W02-C03-S02-T1-R",
    "M6-W02-C03-S02-T1-G",
