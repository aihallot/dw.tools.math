  "id": "RS084",
  "title": "Qualify root residual and Simpson regularity audit limits",
  "commitMessage": "feat: qualify bounded root residual and Simpson regularity audits and close M6 W01 C02",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M6",
    "M6-W01",
    "M6-W01-C02",
    "M6-W01-C02-T2",
    "M6-W01-C02-T2-R",
    "M6-W01-C02-T2-G",
    "M6-W01-C02-T2-V"
  ],
  "contribution": {
    "summary": "Qualify explicit residual and regularity audits over bounded Math root solving and Simpson integration. Recover a compiled missing-API RED, pass 50 GREENs, 44 retained C02 T1 and 108 retained C01 tests, plus two regressions. SHA-qualify real local analysis preview.4 with two independent source-free eight-probe NuGet consumers. Close T2 and C02 only; W01/M6, rigorous error theorems, public NuGet and downstream adoption remain open.",
    "value": "Prevent sign-jump or width-only bisection results from masquerading as small-residual roots; refuse Simpson observations without explicitly declared, unverified caller smoothness. Preserve existing numerical and curve APIs with typed nonpartial failures.",
    "nextAction": "After durable RS084 success, prepare M6-W01-C03-T1 for bounded numerical differentiation and small ODE integration with explicit step and error policy. Keep M6-W01/M6 open.",
    "debtChanges": [
      "Observe one compiled missing-public-audit-API RED before staging new Math numerical source, then recover it alongside 50 independent GREEN scientific tests.",
      "Refuse width-only bisection success when observed function residual exceeds caller tolerance, including discontinuous sign-jump and coarse-width adversarial cases.",
      "Require an explicit, unverified smoothness assumption before admitting a composite Simpson estimate; never infer global error guarantees from finite sampling.",
      "Use typed no-partial-output refusal for untrusted callbacks, nonfinite inputs, cancellation, missing brackets, budget and nonconvergence.",
      "Retain the 44 qualified C02 T1 root/quadrature tests and all 108 C01 interpolation, spline and regression oracles unchanged.",
      "Preserve BCL-only net10 library boundaries and run two relevant Math regression projects without routine full-solution certification.",
      "Inspect one actual locally packed 1.1.0-preview.4 NuGet archive and prove identical bytes in new and retained distinct eight-probe source-free consumers.",
      "Close C02-T2 R/G/V, T2 and phase C02 only; retain M6-W01 and M6 in progress, with C03 and public/downstream adoption unqualified."
    ],
    "achievements": [
      {
        "projectNode": "M6-W01-C02-T2-R",
        "achievement": "Observe a genuine compiled missing public numerical residual/regularity audit API RED against the qualified preceding package."
      },
      {
        "projectNode": "M6-W01-C02-T2-G",
        "achievement": "Implement typed nonpartial residual-qualified root and caller-assumed smoothness Simpson sidecar with 50 independent GREEN test oracles."
      },
      {
        "projectNode": "M6-W01-C02-T2-V",
        "achievement": "Preserve 152 prior focused tests, run two core Math regressions and verify one real local preview.4 nupkg by two separate eight-probe consumers."
      },
      {
        "projectNode": "M6-W01-C02-T2",
        "achievement": "Qualify numerical failure boundaries, explicit unverified regularity and residual-gated admission without claiming a rigorous root or integration error theorem."
      },
      {
        "projectNode": "M6-W01-C02",
        "achievement": "Close T1 and T2 numerical roots/quadrature with independent RED/GREEN, retained tests and local package evidence; M6-W01/M6 remain open."
      }
    ]
  },
