  "contribution": {
    "summary": "Qualify a bounded MathML 3 Content/Presentation exact IR interchange with canonical text and content annotations. Preserve rational, real-symbol, simple sum and original-equality structure; refuse ambiguous presentation, forged markup, DTD and XML budgets. Recover one compiled RED, pass 41 independent GREEN tests, eight isolated NuGet probes and three local package inspections. Complete only C03-T1; leave C03, W01 and M5 open.",
    "value": "Let independent .NET Math consumers exchange exact, typed mathematical content and passive presentation with independently checked source identity rather than guessed visual equivalence.",
    "debtChanges": [
      "Observe a genuine compiled missing MathML public API RED against the previously qualified codecs preview.4, before installing the new preview.5 implementation.",
      "Introduce a pinned MathML 3 annotated profile with Content MathML integer rationals, real x/y/z, simple ordered sums and an original equality restriction, not a solved equation.",
      "Bind passive Presentation MathML to both Math-owned canonical text and independent Content MathML annotations; never infer original math from unannotated display alone.",
      "Import only canonical annotated XML using XmlReader with prohibited DTD, null resolver and tight size/node/depth bounds, refusing altered content, presentation or semantic annotations.",
      "Keep all 41 independent GREEN oracles; replace constant-positive XML limit assertions (MSTEST0032) with runtime refusals for unannotated presentation and over-budget XML, alongside exact IR, annotation and tampering tests.",
      "Run locked .NET 10 Release solution build, the focused codecs suite and IR/quantities regressions; independently inspect three local net10 NuGet archives and their SHA-256.",
      "Run eight standalone NuGet-only consumer oracles through one pinned codecs preview.5 reference with transitive IR/quantities, no project source dependency and no CAS/broker runtime.",
      "Complete C03-T1 RED/GREEN/verification and T1 only. Activate C03; keep T2, C04, W01 and M5 uncompleted and leave public NuGet and stable 1.0 unclaimed."
    ],
    "nextAction": "After durable RS070 success, qualify M5-W01-C03-T2 XML/DTD/depth/namespace adversarial boundaries and semantic-loss guarantees before closing the MathML phase.",
    "achievements": [
      {
        "projectNode": "M5-W01-C03-T1-R",
        "achievement": "Observe a compiled missing exact Content/Presentation MathML and annotation import public API RED on the qualified codecs preview.4."
      },
      {
        "projectNode": "M5-W01-C03-T1-G",
        "achievement": "Implement a bounded exact MathML 3 profile and canonical annotation cross-check with 41 GREEN tests and eight independent pinned NuGet oracles."
      },
      {
        "projectNode": "M5-W01-C03-T1-V",
        "achievement": "Qualify exact IR/content/presentation replay, XML trust refusals, local codecs preview.5 package hashes, tests and runtime evidence."
      },
      {
        "projectNode": "M5-W01-C03-T1",
        "achievement": "Admit exact annotated MathML fraction, symbol, simple addition and original equality interchange, without closing C03 or claiming a general MathML importer."
      }
    ]
  },
