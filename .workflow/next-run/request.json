  ],
  "contribution": {
    "summary": "Qualify a bounded exact real polynomial calculus API: zero-constant antiderivatives, rational definite integrals and finite polynomial limits. Independently verify each primitive with the admitted formal derivative and exact coefficient recovery. Require one compiled absent-API RED, 50 GREEN tests, eight isolated NuGet probes and three local package inspections. Complete only C03-T1 R/G/V and T1; leave C03, M4-W02 and M4 open.",
    "value": "Allow independent .NET callers to obtain reproducible exact rational polynomial integrals and finite limits while preserving arbitrary integration constants, domain policy, source provenance and typed scientific refusals.",
    "debtChanges": [
      "Observe a compiled missing-public-API RED against symbolics preview.8 before installing the new preview.9 exact polynomial calculus source.",
      "Admit degree <=7 exact real polynomials, constant multiplication and sums, with rational endpoints and signed integrals. The zero-constant primitive states its general arbitrary additive constant.",
      "Prove every admitted primitive by the existing qualified formal degree-eight differentiation and independently normalize the resulting exact rational coefficients against the original input.",
      "Use polynomial continuity to admit exact finite limits at rational points. Reject improper integrals, unknown convergence, unsupported domains, units, restrictions, binary64 and arbitrary analytic functions.",
      "Fifty independent GREEN MSTests cover 1/2 and 1/3 integrals, rational coefficients, reversed bounds, degree budgets, derivative recovery, limits and typed refusal boundaries.",
      "Eight independent local pinned NuGet-only .NET 10 client oracles verify integrals, recovered derivatives, finite limits, preserved assumptions and no CAS or agent dependency.",
      "Verify the locked solution and relevant symbolics/IR/quantities suites, inspect three generated net10 product package manifests and SHA-256 checks and leave public NuGet unpublished.",
      "Complete only M4-W02-C03-T1 RED/GREEN/verification children and T1. C03 stays in-progress with T2 not-ready; M4-W02 and M4 remain incomplete."
    ],
    "nextAction": "After durable RS063 success, prepare M4-W02-C03-T2 to qualify pole/singularity and unknown convergence boundaries, integration constants and the remaining M4-W02 closure conditions.",
    "achievements": [
      {
        "projectNode": "M4-W02-C03-T1-R",
        "achievement": "Observe one compiled missing public exact integral/finite-limit API RED against qualified symbolics preview.8."
      },
      {
        "projectNode": "M4-W02-C03-T1-G",
        "achievement": "Deliver exact real bounded polynomial antiderivatives, signed rational definite integrals and finite polynomial limits with 50 GREEN tests and eight package-only consumer oracles."
      },
      {
        "projectNode": "M4-W02-C03-T1-V",
        "achievement": "Qualify primitive derivative coefficient equivalence, domain and budget refusals, symbolics/IR/quantities regression tests and preview.9 local package provenance."
      },
      {
        "projectNode": "M4-W02-C03-T1",
        "achievement": "Admit the exact polynomial calculus T1 contract and record its limits while retaining C03-T2, work package and milestone completion as unfinished."
      }
    ]
  },
