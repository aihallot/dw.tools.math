  "schemaVersion": 1,
  "id": "RS096",
  "title": "Qualify explicit discrete sampling and linear convolution boundary audits",
  "commitMessage": "feat: qualify direct signal boundary audits and close M6 W02 C03 S02",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M6",
    "M6-W02",
    "M6-W02-C03-S02",
    "M6-W02-C03-S02-T2",
    "M6-W02-C03-S02-T2-R",
    "M6-W02-C03-S02-T2-G",
    "M6-W02-C03-S02-T2-V"
  ],
  "contribution": {
    "summary": "Qualify explicit discrete-sampling and zero-extended linear convolution policies with typed nonpartial refusals and conservative spectral/convolution cancellation heuristics. Recover one compiled missing-API RED with 68 GREEN, preserve 464 scientific tests and four Math regressions, and verify four SHA-equal isolated preview.8 NuGet consumers. Close S02-T2 R/G/V, T2 and S02 only; retain S03, original C03, M6-W02 and M6 unfinished.",
    "value": "Gate direct DFT behind caller acceptance of finite discrete samples, not an alias-free guarantee. Refuse circular convolution and unrequested topologies, and classify strong signed cancellation using conservative 1e-12 ratios, without asserting a numerical error theorem, FFT, resampling, physical units or downstream agent adoption.",
    "nextAction": "After durable RS096 success, prepare RS097 on M6-W02-C03-S03-T1: bounded uniformly sampled first differences and sliding arithmetic means with explicit positive sample interval, independently compiled RED/GREEN, regressions and source-free NuGet. Keep S03-T2, original C03 and M6 gates open.",
    "debtChanges": [
      "Observe one independently compiled missing-public signal-boundary-audit RED before staging the sidecar; a compiler error cannot replace RED evidence.",
      "Recover RED with 68 GREEN tests for explicit discrete sampling, DFT forward/inverse, linear topology, cancellation and finite input refusals.",
      "Require caller acceptance of discrete samples; an array alone cannot establish a Nyquist bandwidth, anti-alias filtering or physical sample interval.",
      "Refuse absent convolution topology and explicitly requested circular topology rather than silently substituting periodic convolution.",
      "Conservatively refuse DFT bins with ratio magnitude/sum-input-magnitudes below 1e-12, including exact zeros from cancellation.",
      "Conservatively refuse signed linear convolution outputs below a 1e-12 output/absolute-term ratio, preserving the direct T1 contract.",
      "Retain 60 S02-T1, 53 S01-T2, 25 S01-T1 and 326 C01/C02 scientific tests plus four Math regression projects and transfer validation.",
      "Pack and SHA-inspect one actual BCL-only local scientific preview.8 archive with net10 DLL and source-free NuGet metadata.",
      "Requalify four separately cached eight-probe pinned preview.8 consumers using only a cleared local feed and identical inspected archive bytes.",
      "Close only S02-T2-R/G/V, S02-T2 and S02; S03, original C03 aggregate, M6-W02 and M6 must remain unfinished."
    ],
    "achievements": [
      {
        "projectNode": "M6-W02-C03-S02-T2-R",
        "achievement": "Observe one genuinely compiled missing-public discrete sampling, convolution-topology and cancellation-audit API RED before source staging."
      },
      {
        "projectNode": "M6-W02-C03-S02-T2-G",
        "achievement": "Recover RED and pass 68 independent tests of explicit policies, numerical cancellation, DFT signs, linear convolution and typed refusals."
      },
      {
        "projectNode": "M6-W02-C03-S02-T2-V",
        "achievement": "Preserve 464 scientific tests and four Math regressions, and SHA-verify a real local preview.8 archive through four independent eight-probe NuGet consumers."
      },
      {
        "projectNode": "M6-W02-C03-S02-T2",
        "achievement": "Qualify conservative BCL-only direct-signal boundary audit contracts with explicit discrete-sample/topology policies and nonpartial refusals."
      },
      {
        "projectNode": "M6-W02-C03-S02",
        "achievement": "Complete separately accepted S02 T1/T2 direct DFT and linear convolution contracts with RED/GREEN, risk policies and isolated NuGet evidence, without closing parent C03 or S03."
      }
    ]
