  "title": "Compare pinned managed symbolic providers and qualify conditional-result selection evidence",
  "commitMessage": "docs: qualify M4 symbolic provider candidates and conditional domain behavior",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M4",
