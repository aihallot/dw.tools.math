  "title": "Qualify immutable private NuGet publisher for dependent Math Expression package in a disposable feed",
  "commitMessage": "test: qualify Expression immutable local NuGet publisher rehearsal",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M7"
  ],
  "contribution": {
    "summary": "Qualify a Math Expression local-release controller against a real linked-source dependent package in a disposable NuGet feed, without writing to NUGET_LOCAL.",
    "value": "Reuse the published Dw.Tools.NuGet no-overwrite publisher with an exact dw.quantities dependency, verify archive/DLL identity, collisions, digest and cancellation refusals, and run six source-free binary checks.",
    "debtChanges": [
      "RS139 qualifies only a disposable release rehearsal. Real NUGET_LOCAL publication requires a separate explicit owner action with the original exact RS138 archive.",
      "An independently rebuilt rehearsal package may have different bytes from RS138; never treat its SHA as the original candidate or change an existing version.",
      "Package notices and inherited rights remain private-only; no open-source license, installed-package rollback, crash recovery or other-OS support is newly qualified.",
      "The already published base dw.quantities and original RS134-RS138 source/evidence remain unchanged; dw.quantities.standard cannot advance until Expression is independently published."
    ],
    "nextAction": "After RS139 is durably pushed and physical RS138 bytes are verified, explicitly invoke the guarded --publish then --verify modes for Expression; qualify published readback under DWF before advancing standard units.",
    "achievements": []
  },
