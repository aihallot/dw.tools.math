  "contribution": {
    "summary": "Qualify a closed .NET 10 LaTeX subset importer: exact fractions and real expressions, explicit multiplication, optional caller-declared x(y) convention, and typed refusals for non-injective square/power display, invalid syntax, unsupported macros and limits. Recover one compiled RED, pass 50 independent GREEN tests, eight NuGet-only probes and local package checks. Complete C02-T1 only; leave C02, W01 and M5 open.",
    "value": "Let independent Math consumers import selected exact LaTeX without silently guessing function application, executing TeX, converting to binary64 or claiming a general inverse renderer.",
    "debtChanges": [
      "Observe a compiled missing bounded-LaTeX public API RED against the qualified codecs preview.2 assembly before installing preview.3.",
      "Admit a narrow deterministic ASCII LaTeX grammar for signed exact integers, reduced fractions, x/y/z, sqrt/abs, explicit cdot and bounded sums/grouping; preserve exact typed Math IR.",
      "Default x(y) to Ambiguous and require a caller-selected Multiplication convention to admit mul(x,y), recording the applied policy in the result.",
      "Refuse known T1 square(x)/pow(x,2) identical LaTeX as structurally ambiguous; never fabricate the unique source IR or a proof.",
      "Distinguish Invalid, Unsupported, NonCanonical, Ambiguous and BudgetExceeded for arbitrary macros, missing delimiters, unreduced fractions, unknown functions and resource limits.",
      "Pass 50 independent GREEN tests and one recovered RED; run focused codecs plus exact IR and quantities regressions under locked .NET 10 Release build.",
      "Pack and independently inspect three local Math archives with actual net10 nuspec/dependency/SHA-256 receipts; execute eight isolated pinned NuGet-only consumer oracles.",
      "Complete C02-T1 RED/GREEN/verification and T1 only. Activate C02 and keep M5/W01 in progress; leave C02-T2 and all later M5 integration work untouched."
    ],
    "nextAction": "After durable RS068 success, prepare C02-T2 for semantic-loss provenance, adversarial TeX boundaries and integration without broadening the T1 closed grammar silently.",
    "achievements": [
      {
        "projectNode": "M5-W01-C02-T1-R",
        "achievement": "Observe a genuine compiled missing bounded LaTeX importer API RED on the previously qualified codecs preview.2 assembly."
      },
      {
        "projectNode": "M5-W01-C02-T1-G",
        "achievement": "Implement exact bounded LaTeX import, caller-selected juxtaposition convention and typed ambiguity/refusal with 50 GREEN tests and eight independent NuGet probes."
      },
      {
        "projectNode": "M5-W01-C02-T1-V",
        "achievement": "Qualify locked local codecs preview.3 package manifest/hash, Math IR/quantities regressions, consumer provenance and declared scientific nonclaims."
      },
      {
        "projectNode": "M5-W01-C02-T1",
        "achievement": "Qualify the selected exact fraction/function/multiplication LaTeX subset without completing the broader C02 import or M5 release."
      }
    ]
  },
