  "id": "RS142",
  "title": "Qualify immutable local NuGet publisher for two-dependency Math Standard package in a disposable feed",
  "commitMessage": "test: qualify Standard immutable local NuGet publisher rehearsal",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M7"
  ],
  "contribution": {
    "summary": "Qualify a Standard private NuGet publisher controller by packaging unchanged sources with two exact dependencies and rehearsing no-overwrite publication in a disposable feed.",
    "value": "Reuse Dw.Tools.NuGet to pack a real Standard archive with pinned base and Expression packages, verify archive/DLL and nuspec identities, collision, altered-digest and cancellation refusals, and run ten source-free binary checks.",
    "debtChanges": [
      "RS142 verifies a disposable publisher rehearsal only; a physical NUGET_LOCAL release of the exact original RS141 archive requires a separate explicit owner action.",
      "A newly packed rehearsal package may differ byte-for-byte from the qualified RS141 candidate; its SHA must never be substituted for that original immutable source.",
      "Source versions, two original ProjectReference edges, RS137-RS141 receipts and published prerequisite archives remain unchanged; no public package license is selected.",
      "Installed-package rollback, crash recovery, concurrent publisher assurance, other RID compatibility and Discovery/Decision integration remain unqualified."
    ],
    "nextAction": "After RS142 is pushed, review the exact 13604-byte RS141 candidate and private rights; separately run guarded Standard --publish and --verify modes, then qualify actual shared-feed readback under DWF before further dependent releases.",
    "achievements": []
  },
