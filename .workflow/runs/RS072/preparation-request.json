  ],
  "contribution": {
    "summary": "Qualify exact Math IR as Unicode math with explicit inline/block Markdown wrappers and canonical Office OMML fractions and original equalities. Import requires original typed IR and rejects altered or ambiguous OMML; glyphs never establish semantics alone. Require a compiled missing-API RED, 24 GREEN tests, eight independent pinned NuGet probes and three inspected local archives. Complete only T1, leaving C04, W01 and M5 open.",
    "value": "Enable independent .NET 10 consumers to display Markdown/Unicode or round-trip bounded exact Office OMML equations and fractions while retaining typed Math IR and structural hashes, without Office installation or semantic inference from presentation.",
    "nextAction": "After durable RS072 success, independently qualify C04-T2 unsupported inputs, whole Office document, font/positioning, ambiguity and loss boundaries.",
    "debtChanges": [
      "Observe one compiled missing public OMML and Unicode Markdown codec RED against the previous qualified codecs preview.6 before installing preview.7.",
      "Reuse qualified exact rational, free real symbol, ordered addition and original equality Math IR only; do not add arbitrary Office, TeX, Markdown or XML interpretation.",
      "Render Unicode math as display-only text with independently typed source IR and explicit single-dollar inline or double-dollar block Markdown placement.",
      "Emit canonical standalone m:oMath and exact m:f fraction elements. Require original typed IR and structural plus lexical equality on import; reject source-free typography inference.",
      "Falsify altered denominator/operator, mismatched original IR, foreign document root, malformed XML, DTD/entity, noncanonical source and unsupported grammar.",
      "Recover compiled RED and pass 24 independent GREEN MSTests, locked .NET 10 Release solution build and focused codecs, exact IR and quantities regressions.",
      "Inspect three local net10 NuGet archives with nuspec dependencies, bytes and SHA-256; require eight independent pinned NuGet-only consumer probes.",
      "Complete C04-T1 RED, GREEN, verification and T1 only. Keep C04-T2 not-ready and C04, M5-W01 and M5 open."
    ],
    "achievements": [
      {
        "projectNode": "M5-W01-C04-T1-R",
        "achievement": "Observe a real compiled missing public OMML and Unicode/Markdown codec RED before installing source."
      },
      {
        "projectNode": "M5-W01-C04-T1-G",
        "achievement": "Admit exact rational/equality OMML and Markdown Unicode inline/block wrappers with 24 independent GREEN oracles."
      },
      {
        "projectNode": "M5-W01-C04-T1-V",
        "achievement": "Qualify structural source binding, typed refusals, codecs preview.7 package SHA-256, and eight isolated pinned NuGet probes."
      },
      {
        "projectNode": "M5-W01-C04-T1",
        "achievement": "Complete accepted T1 exact Markdown/Unicode and OMML interchange without closing C04, W01 or M5."
      }
    ]
  },
