  "contribution": {
    "summary": "Qualify exact real candidate-root checks against original IR equations: record verified, excluded, rejected and unresolved points; preserve poles and assumptions; infer completeness and multiplicity only from the admitted T1 elementary contract. Require a compiled absent-API RED, 40 GREEN tests, eight isolated NuGet probes and three local package inspections. Complete C02 only; leave M4-W02 and M4 open.",
    "value": "Let independent .NET consumers distinguish validated exact roots from spurious or domain-excluded candidates and never mistake a partial root list for a complete solution set.",
    "debtChanges": [
      "Observe one genuine compiled missing-public-root-audit-API RED against the previously qualified symbolics preview.7 assembly before installing preview.8.",
      "Forty independent GREEN oracles distinguish complete x²=1 from one verified root, real x²=-1 proven empty, x²=2 unknown, exact rational roots, restricted originals, removable quotient poles and false/unknown candidates.",
      "Only original-form T1-certified elementary equations can yield Complete or proven root multiplicity: x=c simple, x²=0 double and x²=c nonzero roots simple. Verified rational roots of arbitrary quotients remain incomplete and multiplicity unknown.",
      "Original exact substitution evaluates finite IR rational arithmetic without cancellation, hidden denominator holes, ignored retained assumptions, binary64 widening or unproved radicals; no more than eight candidates and a 128-bit exact rational limit.",
      "Eight independent pinned NuGet-only .NET 10 client probes exercise complete vs partial, double root, original quotient exclusion, unknown real roots, retained restrictions, dimensions and no external CAS/broker graph.",
      "Inspect three generated local product packages with separate C# nuspec dependency, net10 assembly, byte length and SHA-256 verification; run relevant exact symbolics, IR and quantities tests and locked solution build.",
      "Complete only M4-W02-C02-T2 R/G/V, T2 and C02. M4-W02-C03 remains not-ready; M4-W02, M4 and other repositories remain unaffected."
    ],
    "nextAction": "After durable RS062 success, prepare M4-W02-C03-T1 only after checking its accepted conditional symbolic provider boundary and scientific falsification tests.",
    "achievements": [
      {
        "projectNode": "M4-W02-C02-T2-R",
        "achievement": "Observe a compiled absent-API RED for independent original-equation root audit before staging product preview.8."
      },
      {
        "projectNode": "M4-W02-C02-T2-G",
        "achievement": "Deliver verified, rejected, excluded and unresolved exact candidate states, bounded complete/partial outcomes, original restrictions and only proved elementary multiplicities, with 40 GREEN tests and eight NuGet-only probes."
      },
      {
        "projectNode": "M4-W02-C02-T2-V",
        "achievement": "Verify exact original-domain evidence, complete relevant symbolics/IR/quantities tests, preview.8 local NuGet manifests and package hashes, locked build and planning integrity."
      },
      {
        "projectNode": "M4-W02-C02-T2",
        "achievement": "Qualify the T2 exact original-root candidate boundary while preserving uncertainty, typed refusals and source provenance."
      },
      {
        "projectNode": "M4-W02-C02",
        "achievement": "Close C02 after the T1 exact elementary solution-set contract and T2 original-domain root/multiplicity integration; leave C03, W02 and M4 open."
      }
    ]
