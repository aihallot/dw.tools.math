  "contribution": {
    "summary": "Complete M4-W01-C02-T2 with a compiled missing-gate RED, 29 independent GREEN tests and eight NuGet-only consumer oracles. Deliver symbolics 0.5.0-preview.2 with a strict admission gate: only canonical native restricted IR matching a locally proven exact source is admitted. Reject opaque objects, provider text, changed/missing conditions and contradictory assumptions. Verify three local package hashes and close C02; keep M4-W01/C03 unfinished.",
    "value": "Prevent a symbolic provider's printed or opaque result from being accepted as mathematical truth without exact native IR restrictions, while retaining a provider-free Math package.",
    "debtChanges": [
      "Compile an independent missing-public-gate RED against the existing preview.1 product before staging its implementation.",
      "Pass 29 scientific GREEN tests for exact conditional identity, dropped/extra/wrong assumptions, hostile ToString refusal, symbol scope and budgets.",
      "Return only a fresh local verified IR restriction, never a foreign object, arbitrary provider string, callback result or unchecked numeric approximation.",
      "Run eight cross-boundary oracles through a single direct NuGet-only preview.2 consumer with no project/provider reference or outside feed.",
      "Independently inspect the exact SHA-256, compiled net10.0 DLLs and dependency graphs of three newly built, local-only packages.",
      "Retain locked Math build and complete relevant symbolics, IR and quantities regressions plus planning and transfer validations.",
      "Close only T2 R/G/V, T2 and C02; keep M4/M4-W01 active and C03 planned, without any external CAS, AURA or dw.discovery integration claim."
    ],
    "nextAction": "After RS056 durable success, prepare the next bounded controlled RED/GREEN for M4-W01-C03-T1 expansions, substitutions and capture-free symbolic transformations while preserving assumptions.",
    "achievements": [
      {
        "projectNode": "M4-W01-C02-T2-R",
        "achievement": "Observe a compiled RED for the missing public symbolic provider result admission API against the existing preview.1 product."
      },
      {
        "projectNode": "M4-W01-C02-T2-G",
        "achievement": "Implement native conditional IR output admission and pass 29 GREEN tests and eight independent NuGet client oracles without accepting opaque, lost-domain or external provider results."
      },
      {
        "projectNode": "M4-W01-C02-T2-V",
        "achievement": "Validate locked symbolics/IR/quantity suites, actual preview.2 package manifests and hashes, the source-only consumer and preserved owner boundaries."
      },
      {
        "projectNode": "M4-W01-C02-T2",
        "achievement": "Complete C02-T2 with a strict typed symbolic proposal filter, real controlled RED/GREEN evidence and explicit refusal of unrepresentable provider results."
      },
      {
        "projectNode": "M4-W01-C02",
        "achievement": "Close M4-W01-C02 after its previously qualified exact T1 bridge and new T2 provider-output boundary; M4-W01 and C03 remain incomplete."
      }
    ]
  },
