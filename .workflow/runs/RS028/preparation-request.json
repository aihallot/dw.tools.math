  "contribution": {
    "summary": "Create the first independent immutable dw.tools.math.ir package after two observed absence REDs. Qualify exact/finite binary64 separation, immutable symbols, scopes, explicit nonzero constraints, one sound real sqrt-square rule, quantity units and ten independently checked contracts plus a locked solution and NuGet package.",
    "value": "Turns the accepted M2 IR architecture into a real provider-free .NET math model that keeps rational precision and symbol-domain restrictions intact instead of silently widening numeric values or applying unsound simplification.",
    "debtChanges": [
      "Only M2-W01-C02-T1 is claimed complete. T2 still owns adversarial whole-graph node/depth/matrix limits, binding safety and larger immutable input validation.",
      "The sqrt(square(x)) normalization is one explicitly guarded real-domain rule, not a general CAS, substitution algorithm or equivalence proof.",
      "Canonical JSON, semantic hashes and OpenMath/Content MathML import/export remain M2-W01-C03/future adapter work; no external AURA adoption is claimed."
    ],
    "nextAction": "Run M2-W01-C02-T2 with independent REDs and targeted GREEN for bounded node/depth/matrix and scope safety, then qualify C02 as a complete immutable typed model before starting the canonical JSON codec.",
    "achievements": [
      {
        "projectNode": "M2-W01-C02-T1-R",
        "achievement": "Two independent tests fail before implementation, proving the absence of both the dw.tools.math.ir assembly and its exact-scalar/bound-symbol public surface."
      },
      {
        "projectNode": "M2-W01-C02-T1-G",
        "achievement": "Install the first provider-free immutable Math IR package with ExactRational-backed exact scalar, finite binary64 bit-preserving kind, bound/free symbol identities, typed operations and explicit real-domain restrictions."
      },
      {
        "projectNode": "M2-W01-C02-T1-V",
        "achievement": "Ten independent IR tests qualify exact versus approximate numeric identity, nonfinite rejection, signed-zero bits, symbol scopes, sqrt(x²)=abs(x) domain rule, x!=1 exclusions, quantity metadata, collection immutability and invalid-input refusals; locked build, complete quantities/foundation regressions and nupkg contents also pass."
      },
      {
        "projectNode": "M2-W01-C02-T1",
        "achievement": "The admitted typed IR functional contract completes with a standalone locked package, independently observed RED/GREEN, guarded one-rule real algebra and durable compilation/package evidence, while T2 adversarial limits remain open."
      }
    ]
  },
