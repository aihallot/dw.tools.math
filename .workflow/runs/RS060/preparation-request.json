  "contribution": {
    "summary": "Qualify M4-W02-C01-T2 through a compiled absent-API RED, 37 independent GREEN tests and eight NuGet-only consumer probes. Deliver exact-rational pointwise derivative evaluation over T1's proven polynomial rules, with typed nondifferentiability at the real absolute/sqrt-square kink, original rational pole exclusions, sqrt real-domain boundaries, unit and assumption refusals. Inspect three local NuGet packages and close only C01 while keeping W02/M4 active.",
    "value": "Make an exact real point derivative distinguishable from a nondifferentiable point, undefined original domain and unknown analytic operation, without finite differences, dropped restrictions or general CAS claims.",
    "debtChanges": [
      "One real compiled missing-API RED precedes installation of the exact pointwise product and preview.6 project version.",
      "37 GREEN tests cover exact polynomial derivative values, absent target, rational point, local real absolute/sqrt-square rules, kink and root-domain refusals, original quotient holes, units and assumptions.",
      "An admitted pointwise value carries its rule ID, original math-ir/1 structural source hash and differentiation target identity; every refusal has no value or proof.",
      "Conservative 128-bit rational and existing IR graph limits prevent unbounded exact evaluation; unsupported radical and quotient derivative forms never fall back to binary64.",
      "Eight independent local NuGet-only probes validate exact cubic slope, absent symbol, kink, domain and dimensional refusals through one pinned symbolics preview.6 package.",
      "Three local Math product archives have separate C# manifest, dependency, net10 assembly, byte-length and SHA-256 checks; no DWF authority is rehashed or package publicly released.",
      "Finish only C01-T2 R/G/V, T2 and C01 after relevant symbolics/IR/quantities regressions; W02 stays in-progress, C02/C03 not-ready, with no AURA/dw.discovery/Decision integration."
    ],
    "nextAction": "After durable RS060 success, prepare M4-W02-C02-T1 from its accepted backlog for a narrowly bounded exact symbolic equation solver, with a genuine RED and independent root/domain oracles.",
    "achievements": [
      {
        "projectNode": "M4-W02-C01-T2-R",
        "achievement": "Observe the compiled missing public pointwise real derivative boundary API against the previously qualified symbolics preview.5 assembly."
      },
      {
        "projectNode": "M4-W02-C01-T2-G",
        "achievement": "Implement exact rational point evaluation and scientific domain/refusal classification, passing 37 independent GREEN and eight package-only consumer oracles."
      },
      {
        "projectNode": "M4-W02-C01-T2-V",
        "achievement": "Verify complete relevant symbolics, IR and quantities suites, preview.6 local product hashes, source/target provenance and no numerical or foreign CAS dependency."
      },
      {
        "projectNode": "M4-W02-C01-T2",
        "achievement": "Complete M4-W02-C01-T2 with typed nondifferentiability, original-domain exclusions, unit and unknown-function refusals, and source-backed RED/GREEN evidence."
      },
      {
        "projectNode": "M4-W02-C01",
        "achievement": "Close the M4-W02-C01 phase after its exact formal polynomial derivative T1 and scientifically bounded real pointwise analysis T2; leave M4-W02 and M4 open."
      }
    ]
  },
