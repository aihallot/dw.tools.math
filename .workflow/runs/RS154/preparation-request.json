  "contribution": {
    "summary": "Rehearse immutable Scientific NuGet publishing on a disposable feed, validating sixteen unchanged source files, fifteen package-only binary probes and refusal boundaries without private-feed publication.",
    "value": "Use pinned Dw.Tools.NuGet to compile a separate rehearsal package from sixteen SHA-pinned original Scientific sources, publish/read back only to a disposable feed, reject collision/altered digest/cancellation, and restore an isolated consumer.",
    "debtChanges": [
      "RS153 original Scientific candidate contains 37265 bytes and unique original archive/DLL SHA-256; a disposable rehearsal archive is separate and cannot replace original bytes.",
      "The original Scientific source Version 1.1.0-preview.14 and 18 source fingerprints, 541 completed native nodes, F1-F20 evidence and six private published packages remain unchanged.",
      "Private NUGET_LOCAL publication, new public license, installed rollback, broader OS/RID certification and Discovery/Decision/AURA integration remain unauthorized."
    ],
    "nextAction": "After successful RS154, the owner may authorize separate guarded --publish and --verify for the exact original F20 archive, then an independent DWF physical-feed readback.",
    "achievements": []
  },
