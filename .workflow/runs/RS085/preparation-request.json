  "contribution": {
    "summary": "Qualify bounded binary64 central difference and fixed-step RK4 in Math analysis preview.5. Observe a compiled public API RED; pass 57 new GREEN, 203 retained analysis tests and two core regressions. Independently SHA-inspect the actual local NuGet archive with a new eight-probe differential consumer and a retained eight-probe C02 consumer. Complete C03-T1 only, leaving C03, W01/M6, rigorous error bounds, public NuGet and downstream adoption unqualified.",
    "value": "Add reusable source-free differentiation and scalar initial-value ODE calculations with explicit numeric step/evaluation budgets, typed refusals and noncertified error estimates while preserving previous curve, root and quadrature contracts.",
    "nextAction": "After durable RS085 success, prepare M6-W01-C03-T2 for stiffness, event and PDE exclusions, overflow, cancellation and local/global error policies; close C03 only after independent qualification.",
    "debtChanges": [
      "Require one genuinely compiled reflection RED for absent derivative/ODE public APIs before staging the new source.",
      "Qualify four-evaluation central finite differences with explicit representable step, finite callback values and heuristic h/h2 error estimates.",
      "Qualify scalar forward-time fixed-step RK4 using N/2N step refinement, bounded evaluation counts and no claimed global-error theorem.",
      "Observe 57 new independent GREEN, recover RED, and retain all 203 previous C01/C02 focused tests without changing their APIs.",
      "Refuse invalid policy, unrepresentable steps, overflow, callback errors, nonfinite data, cancellation and unmet error-estimate limits without partial outputs.",
      "Validate relevant numerics and composition regressions; avoid unrelated routine full-solution certification.",
      "Pack a real local net10 1.1.0-preview.5 NuGet archive, inspect SHA/nuspec, and verify identical bytes in two independent eight-probe source-free consumers.",
      "Complete C03 T1 RED/GREEN/V only. Preserve C03 T2, stiffness/events/PDE, public release and Decision/MCDM/AURA adoption as unqualified."
    ],
    "achievements": [
      {
        "projectNode": "M6-W01-C03-T1-R",
        "achievement": "Observe one genuinely compiled absent public derivative/ODE API RED on the qualified preceding version."
      },
      {
        "projectNode": "M6-W01-C03-T1-G",
        "achievement": "Deliver bounded central-difference and scalar RK4 methods with 57 independent numerical and refusal GREEN tests."
      },
      {
        "projectNode": "M6-W01-C03-T1-V",
        "achievement": "Preserve 203 earlier analysis tests and two relevant Math regressions, with a real preview.5 SHA-confirmed by two eight-probe NuGet-only consumers."
      },
      {
        "projectNode": "M6-W01-C03-T1",
        "achievement": "Qualify finite derivative and scalar ODE estimates with explicit noncertified error and resource policies; leave C03 T2 and M6 open."
      }
    ]
  },
