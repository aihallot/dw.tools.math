  "contribution": {
    "summary": "Qualify a source-identical Foundation NuGet calendar candidate with zero dependencies and five independent package-only binary contract probes, without private-feed publication.",
    "value": "Build and pack the unchanged FoundationContract source and source csproj, verify the actual .nuspec and DLL hashes, and compile a fresh single-PackageReference consumer with exact identity, loaded SHA and provider-refusal checks.",
    "debtChanges": [
      "The Foundation candidate is unpublished, unreserved and immutable by ID/version once its original bytes are qualified; later publication remains a distinct owner decision.",
      "Historical Foundation source Version 0.1.0-preview.1, the single original C# source, all 541 completed native nodes and five published private packages remain unchanged.",
      "Foundation is only a bootstrap contract, not scientific accuracy proof; public licensing, installed rollback, OS/RID claims, Decision, Discovery and AURA adoption remain out of scope."
    ],
    "nextAction": "After a successful RS150, rehearse the immutable Foundation publisher on a disposable feed; require separate owner consent for publication of exact original candidate bytes.",
