{
  "schemaVersion": 1,
  "id": "RS044",
  "title": "Implement bounded exact and compensated descriptive statistics in a provider-neutral package",
  "commitMessage": "feat: qualify independent finite and exact descriptive statistics",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M3",
    "M3-W02",
    "M3-W02-C01",
    "M3-W02-C01-T1",
    "M3-W02-C01-T1-R",
    "M3-W02-C01-T1-G",
    "M3-W02-C01-T1-V"
  ],
  "contribution": {
    "summary": "Qualify a standalone .NET descriptive-statistics package using a controlled missing-contract RED and 19 independent GREEN tests: exact rational sums/means/extrema, compensated finite sums, centered population/sample variance, limits and nonfinite refusals. Register two lowercase projects with locked dependencies, corroborate using managed Math.NET 5.0.0, check the local NuGet package, and complete C01-T1 without closing C01 or M3-W02.",
    "value": "Give Math consumers reproducible, explicitly exact or approximate statistics without importing Decision or Math.NET implementation types. Report undefined singleton sample variance, separate sample/population denominators, numerical budgets and results with evidence rather than inferred scientific admission.",
    "debtChanges": [
      "Statistics C01-T2 remains planned for explicit missing-value and weighted-input policies, further numerical scale limits and refusal semantics. A successful T1 is not completion of C01.",
      "The provider-free statistics product depends only on dw.quantities; managed Math.NET 5.0.0 remains an independent test-only corroborator on the actually observed host.",
      "Exact rational aggregates enforce finite cardinality and operand/intermediate bit budgets; floating Neumaier/centered variance does not become exact arithmetic or a universal conditioning guarantee.",
      "Quantiles, correlation, distribution sampling, probability conventions and consumer interoperability are separate accepted later M3-W02 scopes.",
      "No nutrition RecordTransformer, Decision VaR/CVaR, Aura host behavior, BrokerReady claim, or local implementation of the neutral dw.discovery contract is introduced.",
      "The new .NET projects and lockfiles are part of a coherent executable source slice, not permanent root product code or empty unqualified scaffolding.",
      "Published artifacts remain local NuGet candidates; no public package feed, native BLAS, paid CI or unexecuted platform is admitted."
    ],
    "nextAction": "On RS044 success, qualify M3-W02-C01-T2's missing/weighted observations and boundary policies under the existing native plan. Watch neutral dw.discovery and Workflow #139 separately without duplicating them in Math.",
    "achievements": [
      {
        "projectNode": "M3-W02-C01-T1-R",
        "achievement": "Compile a new test-only project against the empty statistics assembly and observe the exact missing-contract RED before installing product algorithms."
      },
      {
        "projectNode": "M3-W02-C01-T1-G",
        "achievement": "Deliver bounded finite IEEE binary64 compensated sums and population/sample descriptive statistics, alongside separate exact rational sum, mean and extrema."
      },
      {
        "projectNode": "M3-W02-C01-T1-V",
        "achievement": "Pass nineteen independent numerical GREEN cases, recovered RED, managed Math.NET descriptive corroboration, relevant Math regressions and locked local NuGet package checks."
      },
      {
        "projectNode": "M3-W02-C01-T1",
        "achievement": "Complete the accepted descriptive statistics T1 contract with durable source, oracles, package and documentation evidence while preserving C01-T2 as planned."
      }
    ]
  },
