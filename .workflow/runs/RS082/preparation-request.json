{
  "schemaVersion": 1,
  "id": "RS082",
  "title": "Qualify bounded curve units, extrapolation and relative numerical conditioning",
  "commitMessage": "feat: qualify Math curve unit conditioning boundaries and close M6 W01 C01",
  "timeoutSeconds": 1800,
  "projectNodes": [
    "M6",
    "M6-W01",
    "M6-W01-C01",
    "M6-W01-C01-T2",
    "M6-W01-C01-T2-R",
    "M6-W01-C01-T2-G",
    "M6-W01-C01-T2-V"
  ],
  "contribution": {
    "summary": "Qualify finite curve units, relative conditioning and opt-in linear extrapolation in the Math net10 analysis package. Recover one compiled API RED and pass 59 GREENs, 48 retained T1 tests and four core regressions. SHA-qualify preview.2 using two distinct NuGet-only eight-probe consumers. Close only T2/C01, not W01/M6; no public or downstream adoption. Correct the prior RS082 C# payload syntax refusal before attempt allocation.",
    "value": "Make interpolated and descriptive-fit results explicit about caller units, ill-conditioned abscissae, opt-in extrapolation and nonpartial refusals while retaining the proven T1 package surface and independent local consumers.",
    "nextAction": "After durable RS082 success, prepare M6-W01-C02-T1 for bounded univariate root finding and quadrature with explicit tolerance and residual diagnostics; no stable/public package publication.",
    "debtChanges": [
      "Keep existing T1 linear/spline/OLS scientific contracts and 48 focused tests intact while qualifying a separate public boundary-audit API.",
      "Require one compiled missing unit/conditioning API RED before staging T2 source and 59 independently asserted GREEN tests.",
      "Admit finite 2-32 sorted samples, typed near-rank relative-span refusal, simple caller-declared unit tags and explicit line-only extrapolation.",
      "Refuse unit mismatch, over-budget/nonfinite data, unknown policy, unrequested extrapolation and unsupported inference without partial numeric results.",
      "Retain the old NuGet-only eight-probe consumer under the exact T1/T2 local-feed allowlist while pinning actual analysis preview.2.",
      "Repack and SHA-256 inspect one real preview.2 archive and cross-check the identical bytes through a second eight-probe NuGet-only client.",
      "Run locked Release build, all new T2 and retained T1 targeted tests, the full analysis test project and four relevant Math regressions.",
      "Close C01-T2 R/G/V, task and C01 only; leave M6-W01/M6, C02 root finding and stable/public NuGet as separately qualified future work."
    ],
    "achievements": [
      {
        "projectNode": "M6-W01-C01-T2-R",
        "achievement": "Observe a genuinely compiled missing public curve unit/extrapolation/conditioning API RED, separate from compiler or restore refusal."
      },
      {
        "projectNode": "M6-W01-C01-T2-G",
        "achievement": "Implement caller-declared dimensional labels, explicit linear extrapolation and bounded relative-span policy with 59 independent GREEN scientific oracles."
      },
      {
        "projectNode": "M6-W01-C01-T2-V",
        "achievement": "Retain 48 previous T1 tests and four relevant regressions; verify one actual preview.2 nupkg SHA through two separate eight-probe consumers."
      },
      {
        "projectNode": "M6-W01-C01-T2",
        "achievement": "Complete qualified T2 numerical loss, units, extrapolation and near-rank refusal boundaries without forecast/causality or automatic conversion."
      },
      {
        "projectNode": "M6-W01-C01",
        "achievement": "Close both analysis and explicit boundary tasks for M6-W01-C01; retain M6-W01 and M6 in progress."
      }
    ]
  },
